#include <winver.h>

1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     @V1@,@V2@,@V3@,0
PRODUCTVERSION  @V1@,@V2@,@V3@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "042204B0"
    BEGIN
      VALUE "CompanyName",      "fesh-biz"
      VALUE "FileDescription",  "Remote Desktop - server"
      VALUE "FileVersion",      "@VERSION@"
      VALUE "InternalName",     "RemoteDesktop"
      VALUE "OriginalFilename", "RemoteDesktop.exe"
      VALUE "ProductName",      "Remote Desktop"
      VALUE "ProductVersion",   "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0422, 1200
  END
END
